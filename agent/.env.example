# API -- runs on the machine the devices are connected to
# 127.0.0.1 is this machine only; use 0.0.0.0 (or a VPN address, e.g. Tailscale)
# for another machine to reach it. The Devices app on this computer uses it to
# control the devices; devices.bayfield.dev does not need it (the agent connects out).
API_HOST = 127.0.0.1
API_PORT = 7000
API_DOMAIN = http://localhost:7000
API_DEBUG = False

# The single token every route requires (32+ characters); give it to the Devices
# app on this computer (Settings > This computer). Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN =

# Seconds between two battery polls. The rate adapts, for accurate data without
# draining the devices: POLL_INTERVAL_ACTIVE while the Devices app is open on this
# computer, POLL_INTERVAL_MIN while a battery moves (charging, low or changing),
# POLL_INTERVAL when everything is steady.
POLL_INTERVAL = 60
POLL_INTERVAL_MIN = 30
POLL_INTERVAL_ACTIVE = 1

# Battery history: the SQLite file it is kept in, and how many days of it
HISTORY_PATH = data/battery.db
HISTORY_DAYS = 90

# devices.bayfield.dev -- the server that gathers the devices of every PC.
# Create this PC's key in the app (Settings > Computers > Add a computer);
# leave both empty to run on your own, with the local API only.
CENTRAL_URL = https://devices.bayfield.dev
AGENT_KEY =
# How this PC is called in the app (the hostname by default)
AGENT_NAME =

# Origins allowed to call this API from a browser (comma-separated). Default: the
# Devices web app, its desktop app and the Vite dev server.
# CORS_ORIGINS = https://devices.bayfield.dev,tauri://localhost,http://tauri.localhost
