# The Devices agent, run on its own (uv run __main__.py serve): copy to .env.
# The desktop app doesn't need this file: it starts the agent itself, with the
# key it got when you linked the computer.

# devices.bayfield.dev -- the server that keeps the data of every computer.
# Create this computer's key in the web app (Settings > Computers > Add a
# computer); leave both empty to keep the history on this computer only.
CENTRAL_URL = https://devices.bayfield.dev
AGENT_KEY =
# How this computer is called in the app (the hostname by default)
AGENT_NAME =

# Seconds between two battery polls. The rate adapts, for accurate data without
# draining the devices: POLL_INTERVAL_ACTIVE while the Devices app is open on this
# computer, POLL_INTERVAL_MIN while a battery moves (charging, low or changing),
# POLL_INTERVAL when everything is steady.
POLL_INTERVAL = 60
POLL_INTERVAL_MIN = 30
POLL_INTERVAL_ACTIVE = 1

# Battery history: the SQLite file it is kept in (the queue of what the server
# hasn't received yet), and how many days of it
HISTORY_PATH = data/battery.db
HISTORY_DAYS = 90
