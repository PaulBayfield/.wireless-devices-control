{
  "name": "devices-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Devices API: gathers the agents' reports in a SQLite file and forwards them to internal.bayfield.dev",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/index.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch --env-file-if-exists=.env src/index.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "~7.0.2"
  }
}
