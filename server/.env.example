# Copy to server/.env for local runs, or pass these to the container.

# Where Devices is reachable (OIDC redirect).
PUBLIC_URL=https://devices.bayfield.dev
PORT=8830

# PostgreSQL. Docker Compose sets this for you; for local development without Docker,
# `npm run db:dev` starts a local Postgres on this address.
DATABASE_URL=postgres://postgres:devices@127.0.0.1:5438/devices
# DATABASE_POOL_MAX=10

# --- Sign in with Authentik (any OIDC provider works): the only way in for people, required ---
# Authentik: Applications → Providers → OAuth2/OpenID, confidential client,
# redirect URI ${PUBLIC_URL}/api/auth/oidc/callback, scopes openid profile email.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# OIDC_NAME=Authentik
# Create accounts on first sign-in (default true). The very first account is the admin.
# OIDC_AUTO_CREATE=true
# Comma-separated Authentik groups allowed in (empty: anyone the provider lets through).
# OIDC_ALLOWED_GROUPS=
# Members of these groups are admins (add computers, manage users). Checked at every sign-in.
# OIDC_ADMIN_GROUPS=

# Local development without Authentik: sign straight in as this user (created if missing).
# Only honoured when PUBLIC_URL is http://localhost; leave unset everywhere else.
# DEV_LOGIN_USER=demo
# Idle days before a session expires.
# SESSION_IDLE_DAYS=30

# Header your reverse proxy puts the visitor IP in, used for rate limiting
# (behind a Cloudflare Tunnel: cf-connecting-ip).
# CLIENT_IP_HEADER=cf-connecting-ip

# Days of battery history kept here (internal.bayfield.dev keeps everything).
# HISTORY_DAYS=365

# --- internal.bayfield.dev: copy every computer, device and battery run there ---
# Create the key on internal.bayfield.dev with the devices:write scope:
#   uv run scripts/create_api_key.py devices.bayfield.dev --scope devices:write
# Leave both unset to keep the data here only.
# INTERNAL_URL=https://internal.bayfield.dev
# INTERNAL_API_KEY=
# INTERNAL_SYNC_MINUTES=5

# More origins allowed to call the API with an API key (comma-separated), besides the desktop app.
# EXTRA_ORIGINS=

# Look on GitHub for a newer release, shown in Settings → About (cached for 6 hours).
# UPDATE_CHECK=true
