# API -- runs on the machine the devices are connected to
# 127.0.0.1 is this machine only; use 0.0.0.0 (or a VPN address, e.g. Tailscale)
# for the frontend server to reach it.
API_HOST = 127.0.0.1
API_PORT = 7000
API_DOMAIN = http://localhost:7000
API_DEBUG = False

# The single token every route requires (32+ characters). Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN =

# Seconds between two battery polls
POLL_INTERVAL = 60
